MONGODB_URI=mongodb://127.0.0.1:27017/reflow
GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_openweathermap_api_key_here
# Booking.com via RapidAPI (host: booking-com15.p.rapidapi.com) — real hotel
# rates + cancellation policies for parsed itineraries and the Extend Stay feature.
RAPIDAPI_KEY=your_rapidapi_key_here
# MapTiler — base map tiles for the Trip Map (labels forced to English). Public
# key, inlined into the client bundle; restrict it by URL in the MapTiler console.
# Get one free at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
# Default region bias for geocoding (ISO 3166 country code). Ambiguous place
# names and itineraries with no clear country signal resolve here, and every
# stop's coordinate is validated against this region's bounds. Defaults to IN.
NEXT_PUBLIC_GEO_REGION=IN